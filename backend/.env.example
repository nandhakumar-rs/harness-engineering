# Session 1: add your key, then `uv add openai`
OPENAI_API_KEY=
MODEL=gpt-4.1-mini
MAX_ITERATIONS=6

# Session 2: Postgres for the event log
# Use the DIRECT connection string, not the "-pooler" one: the pooler (PgBouncer, transaction
# mode) can move each transaction to a different server connection, which breaks LISTEN/NOTIFY
# (event bus, DBOS) and other session features. A long-running server needs no pooling anyway.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
